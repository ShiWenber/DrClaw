# DrClaw Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================
# LLM Provider Configuration
# ============================================================
# Required: Your API key for the LLM provider
DRCLAW_PROVIDER_API_KEY=your-api-key-here

# Optional: Custom API base URL (e.g., for proxy or local models)
# DRCLAW_PROVIDER_API_BASE=http://localhost:11434/v1

# Optional: Model to use (default: anthropic/claude-sonnet-4-5)
# DRCLAW_PROVIDER_MODEL=anthropic/claude-sonnet-4-5

# Optional: Provider type (default: litellm)
# Supported: litellm, openai, anthropic, google, moonshot
# - litellm: Uses LiteLLM (supports 100+ LLM providers)
# - openai: Uses OpenAI's official SDK (better for OpenAI API)
# - anthropic: Uses LiteLLM with Anthropic models
# - google: Uses LiteLLM with Google models
# - moonshot: Uses LiteLLM with Moonshot models
# DRCLAW_PROVIDER_TYPE=litellm

# ============================================================
# Feishu/Lark Bot Configuration
# ============================================================
# Required for Feishu bot functionality
# Get these from your Feishu open platform application settings
DRCLAW_FEISHU_APP_ID=your-app-id
DRCLAW_FEISHU_APP_SECRET=your-app-secret
DRCLAW_FEISHU_ENCRYPT_KEY=your-encrypt-key
DRCLAW_FEISHU_VERIFICATION_TOKEN=your-verification-token

# ============================================================
# Web UI Configuration
# ============================================================
# Web UI port (default: 8081)
# DRCLAW_WEB_PORT=8081

# Web UI bind host (default: 0.0.0.0)
# DRCLAW_WEB_HOST=0.0.0.0
